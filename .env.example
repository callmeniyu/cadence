# Supabase project URL, e.g. https://xxxxx.supabase.co
VITE_SUPABASE_URL=

# Client-safe publishable/anon key ONLY. Never put a service-role key here.
# (Newer Supabase projects may label this the "publishable" key; older
# projects call it the "anon" key — either works here.)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to "true" to run entirely on local seeded demo data (no Supabase
# project required). Set to "false" (or omit) once real credentials above
# are filled in to use the live Supabase backend.
VITE_DEMO_MODE=true
